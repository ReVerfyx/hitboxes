<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="ReVerfyx Client Launcher"
           Manufacturer="ReVerfyx"
           Version="1.0.0"
           UpgradeCode="5b1f6b9a-6f0e-4d3a-9c1f-2b7e2b6a0f3e"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="Уже установлена более новая версия [ProductName]." />
    <MediaTemplate EmbedCab="yes" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="ReVerfyx Client Launcher">
        <Component Id="MainExecutable" Guid="5c1e1b1a-2222-4a11-9b11-000000000001" Bitness="always64">
          <File Id="LauncherExe" Source="..\..\publish\ReVerfyxClientLauncher.exe" KeyPath="yes">
            <Shortcut Id="StartMenuShortcut"
                      Directory="ProgramMenuFolder"
                      Name="ReVerfyx Client Launcher"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="yes" />
            <Shortcut Id="DesktopShortcut"
                      Directory="DesktopFolder"
                      Name="ReVerfyx Client Launcher"
                      WorkingDirectory="INSTALLFOLDER"
                      Advertise="yes" />
          </File>
        </Component>

        <Directory Id="BundledModDir" Name="bundled-mod">
          <Component Id="BundledModComponent116" Guid="5c1e1b1a-2222-4a11-9b11-000000000002" Bitness="always64">
            <File Id="BundledModJar116" Source="..\..\publish\bundled-mod\ReVerfyxClient-1.16.5.jar" KeyPath="yes" />
          </Component>
          <Component Id="BundledModComponent1214" Guid="5c1e1b1a-2222-4a11-9b11-000000000003" Bitness="always64">
            <File Id="BundledModJar1214" Source="..\..\publish\bundled-mod\ReVerfyxClient-1.21.4.jar" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="MainFeature" Title="ReVerfyx Client Launcher" Level="1">
      <ComponentRef Id="MainExecutable" />
      <ComponentRef Id="BundledModComponent116" />
      <ComponentRef Id="BundledModComponent1214" />
    </Feature>
  </Package>
</Wix>
