{
  "schemaVersion": 1,
  "id": "hitboxdebug",
  "version": "${version}",
  "name": "Hitbox Debug Panel",
  "description": "Debug/utility panel for singleplayer worlds: mob auto-farm, hitbox visualization, auto-eat, step-by-step farm builder. No PvP features.",
  "authors": ["hitboxes"],
  "contact": {},
  "license": "MIT",
  "icon": "assets/hitboxdebug/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.local.hitboxdebug.HitboxDebugClient"
    ]
  },
  "mixins": [
    "hitboxdebug.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.11.0",
    "fabric": "*",
    "minecraft": "1.16.5"
  }
}
