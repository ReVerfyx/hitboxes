<Window x:Class="Hitboxes.Launcher.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки лаунчера" Height="620" Width="460"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Border Style="{StaticResource GlassCardStyle}" Margin="16">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
        <StackPanel Margin="20">
            <TextBlock Text="Java (по умолчанию для новых сборок)" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="JavaPathBox" Margin="0,0,0,16" />

            <TextBlock Text="Память, МБ (мин / макс)" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox x:Name="MemMinBox" Width="90" Margin="0,0,8,0" />
                <TextBox x:Name="MemMaxBox" Width="90" />
            </StackPanel>

            <TextBlock Text="Дополнительные аргументы JVM" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <TextBox x:Name="JvmArgsBox" Margin="0,0,0,16" />

            <Separator Margin="0,0,0,16" />

            <TextBlock Text="Цвет стекла" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                <Border x:Name="GlassSwatch1" Width="32" Height="32" CornerRadius="16" Margin="0,0,8,0"
                        Background="#4FA8FF" Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                <Border x:Name="GlassSwatch2" Width="32" Height="32" CornerRadius="16" Margin="0,0,8,0"
                        Background="#FF6FA8" Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                <Border x:Name="GlassSwatch3" Width="32" Height="32" CornerRadius="16" Margin="0,0,8,0"
                        Background="#7CE0A0" Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                <Border x:Name="GlassSwatch4" Width="32" Height="32" CornerRadius="16" Margin="0,0,8,0"
                        Background="#B98CFF" Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                <Border x:Name="GlassSwatch5" Width="32" Height="32" CornerRadius="16"
                        Background="#FFC966" Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBox x:Name="GlassHexBox" Width="120" Margin="0,0,8,0" TextChanged="GlassHexBox_TextChanged" />
                <Border x:Name="GlassPreview" Width="32" Height="32" CornerRadius="16"
                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
            </StackPanel>

            <Separator Margin="0,0,0,16" />

            <CheckBox x:Name="MusicEnabledBox" Content="Музыка C418 в главном меню"
                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
            <TextBlock Text="Громкость музыки" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
            <Slider x:Name="MusicVolumeSlider" Minimum="0" Maximum="1" Margin="0,0,0,16" />

            <Separator Margin="0,0,0,16" />

            <CheckBox x:Name="RainAutoDetectBox" Content="Автоопределение дождя по погоде (OpenWeatherMap)"
                      Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
            <TextBox x:Name="WeatherApiKeyBox" Margin="0,0,0,8" Tag="API-ключ OpenWeatherMap" />
            <TextBox x:Name="WeatherCityBox" Margin="0,0,0,16" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Отмена" Style="{StaticResource GlassSecondaryButtonStyle}" Margin="0,0,8,0" Click="Cancel_Click" />
                <Button Content="Сохранить" Style="{StaticResource GlassButtonStyle}" Click="Save_Click" />
            </StackPanel>
        </StackPanel>
        </ScrollViewer>
    </Border>
</Window>
