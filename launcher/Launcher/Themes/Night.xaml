<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#0B1026" Offset="0" />
        <GradientStop Color="#1B1F3B" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PanelBrush" Color="#1A1E3A" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#EAF0FF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9AA6D6" />
    <SolidColorBrush x:Key="AccentBrush" Color="#7C6FE0" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#9C90FF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#33395E" />

</ResourceDictionary>
