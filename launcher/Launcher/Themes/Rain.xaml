<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#4A5A66" Offset="0" />
        <GradientStop Color="#6E7F8C" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PanelBrush" Color="#3F4C56" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#E7EEF2" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#AFC0C9" />
    <SolidColorBrush x:Key="AccentBrush" Color="#4FA3C4" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#6FC0E0" />
    <SolidColorBrush x:Key="BorderBrush" Color="#566873" />

</ResourceDictionary>
