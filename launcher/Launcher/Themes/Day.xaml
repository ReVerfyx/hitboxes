<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <LinearGradientBrush x:Key="BackgroundBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#8FD3F4" Offset="0" />
        <GradientStop Color="#E3F6FF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush x:Key="PanelBrush" Color="#F5FBFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1B2A33" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4E6672" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2E9CCA" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#227DA3" />
    <SolidColorBrush x:Key="BorderBrush" Color="#C9E6F2" />

</ResourceDictionary>
