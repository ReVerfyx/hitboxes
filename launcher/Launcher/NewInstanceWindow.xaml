<Window x:Class="Hitboxes.Launcher.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая сборка" Height="320" Width="420"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Border Style="{StaticResource GlassCardStyle}" Margin="16">
    <StackPanel Margin="20">
        <TextBlock Text="Название" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
        <TextBox x:Name="NameBox" Text="Новая сборка" Margin="0,0,0,16" />

        <TextBlock Text="Версия Minecraft (1.16.5+)" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
        <ComboBox x:Name="VersionComboBox" Margin="0,0,0,16" DisplayMemberPath="Id" />

        <TextBlock Text="Загрузчик модов" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,4" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
            <RadioButton x:Name="VanillaRadio" Content="Vanilla" GroupName="Loader" IsChecked="True"
                         Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
            <RadioButton x:Name="FabricRadio" Content="Fabric (для модов)" GroupName="Loader"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <TextBlock x:Name="ErrorText" Foreground="#D9534F" Margin="0,0,0,8" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Отмена" Style="{StaticResource GlassSecondaryButtonStyle}" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Создать" Style="{StaticResource GlassButtonStyle}" Click="Create_Click" />
        </StackPanel>
    </StackPanel>
    </Border>
</Window>
