<Window x:Class="Hitboxes.Launcher.NewInstanceWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Новая сборка" Height="560" Width="440" MinHeight="380"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Border Style="{StaticResource GlassCardStyle}" Margin="16">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto" Padding="22,22,22,0">
        <StackPanel>
            <TextBlock Text="Новая сборка" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,18" />

            <TextBlock Text="Название" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6" />
            <TextBox x:Name="NameBox" Text="Новая сборка" Margin="0,0,0,18" />

            <TextBlock Text="Версия Minecraft (1.16.5+)" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,6" />
            <TextBox x:Name="VersionSearchBox" Margin="0,0,0,8" TextChanged="VersionSearchBox_TextChanged" />
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Height="150" Margin="0,0,0,18">
                <ListBox x:Name="VersionListBox" BorderThickness="0" Background="Transparent" DisplayMemberPath="Id" />
            </Border>

            <TextBlock Text="Загрузчик модов" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" Margin="0,0,0,8" />
            <StackPanel Orientation="Horizontal" Margin="0,0,0,22">
                <RadioButton x:Name="VanillaRadio" Content="Vanilla" GroupName="Loader" IsChecked="True"
                             Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,16,0" />
                <RadioButton x:Name="FabricRadio" Content="Fabric (для модов)" GroupName="Loader"
                             Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <TextBlock x:Name="ErrorText" Foreground="#D9534F" Margin="0,0,0,8" TextWrapping="Wrap" />
        </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="22,8,22,22">
            <Button Content="Отмена" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="Cancel_Click" />
            <Button Content="Создать" Style="{StaticResource PrimaryButtonStyle}" Click="Create_Click" />
        </StackPanel>
    </Grid>
    </Border>
</Window>
