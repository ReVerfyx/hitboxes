<Window x:Class="Hitboxes.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReVerfyx Launcher" Height="740" Width="1200"
        MinHeight="640" MinWidth="960"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Ambient background glow — soft blurred brand-colored blobs behind the
             sidebar/content panels, giving the frosted panels something to read as
             "glass" over without a real OS blur-behind (kept off to avoid the DWM
             calls that have crashed this app's CI runner before). -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="-160" Canvas.Top="-160" Width="480" Height="480" Fill="#8B7CFF" Opacity="0.16">
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Right="-160" Canvas.Bottom="-160" Width="480" Height="480" Fill="#6658E8" Opacity="0.14">
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="230" />
                <ColumnDefinition Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============ Sidebar ============ -->
            <Border Grid.Column="0" Style="{StaticResource GlassCardStyle}" CornerRadius="22" Padding="18">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top">
                        <StackPanel Orientation="Horizontal" Margin="5,4,4,30">
                            <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource AccentGradientBrush}">
                                <TextBlock Text="R" FontSize="17" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ReVerfyx" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Launcher" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                        <Button x:Name="HomeNavButton" Content="Главная" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4" Click="HomeButton_Click" />
                        <Button x:Name="InstancesNavButton" Content="Сборки" Style="{StaticResource NavButtonStyle}" Margin="0,0,0,4" Click="InstancesButton_Click" />
                        <Button x:Name="SettingsNavButton" Content="Настройки" Style="{StaticResource NavButtonStyle}" Click="SettingsButton_Click" />
                    </StackPanel>

                    <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="13">
                        <StackPanel>
                            <TextBlock Text="СОСТОЯНИЕ" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center">
                                    <Ellipse.Effect>
                                        <DropShadowEffect Color="#4ADE80" Opacity="0.8" BlurRadius="8" ShadowDepth="0" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock x:Name="StatusText" Text="Готов к запуску" FontSize="11" Margin="7,0,0,0"
                                           Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- ============ Main content ============ -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="62" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="4,0">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="PageTitle" Text="Главная" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="PageSubtitle" Text="Выбор сборки" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <Border HorizontalAlignment="Right" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="8,7" Cursor="Hand" MouseLeftButtonUp="AccountChip_Click"
                            ToolTip="Открыть настройки, чтобы сменить ник">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentGradientBrush}">
                                <TextBlock x:Name="AvatarInitial" Text="P" FontSize="12" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,4,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AccountNameText" Text="Player" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Оффлайн аккаунт" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Grid Grid.Row="1">
                    <!-- ============ Home ============ -->
                    <Grid x:Name="HomeView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" CornerRadius="26" MinHeight="340">
                            <Grid>
                                <Ellipse Width="360" Height="360" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Margin="0,-140,-140,0" Fill="#8B7CFF" Opacity="0.20">
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="90" />
                                    </Ellipse.Effect>
                                </Ellipse>

                                <Border Width="190" Height="190" CornerRadius="40" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Margin="0,0,60,0" Background="#128B7CFF" BorderBrush="#1FFFFFFF" BorderThickness="1"
                                        RenderTransformOrigin="0.5,0.5">
                                    <Border.RenderTransform>
                                        <RotateTransform Angle="12" />
                                    </Border.RenderTransform>
                                    <TextBlock Text="R" FontSize="90" FontWeight="Bold" Foreground="#14FFFFFF"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel VerticalAlignment="Center" Margin="44,0,0,0" MaxWidth="620">
                                    <Border Background="#1D8B7CFF" BorderBrush="#338B7CFF" BorderThickness="1" CornerRadius="7"
                                            Padding="9,5" HorizontalAlignment="Left">
                                        <TextBlock Text="ВЫБРАННАЯ СБОРКА" FontSize="9" FontWeight="Bold" Foreground="#C9BFFF" />
                                    </Border>
                                    <TextBlock x:Name="SelectedName" Text="ReVerfyx" FontSize="42" FontWeight="Bold"
                                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,16,0,0" TextTrimming="CharacterEllipsis" />
                                    <TextBlock x:Name="SelectedSubtitle" Text="Minecraft 1.21.4 · Fabric" FontSize="13"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0" />
                                    <StackPanel Orientation="Horizontal" Margin="0,26,0,0">
                                        <Button x:Name="PlaySelectedButton" Content="▶  ИГРАТЬ" Style="{StaticResource PrimaryButtonStyle}" Padding="26,13" Click="PlaySelected_Click" />
                                        <Button x:Name="EditSelectedButton" Content="Настроить" Style="{StaticResource SecondaryButtonStyle}" Padding="18,12" Margin="10,0,0,0" Click="EditSelected_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource StatCardStyle}" Padding="16" Margin="0,0,6,0">
                                <StackPanel>
                                    <TextBlock Text="ПАМЯТЬ" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="RamLabel" Text="4 ГБ" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="1" Style="{StaticResource StatCardStyle}" Padding="16" Margin="6,0">
                                <StackPanel>
                                    <TextBlock Text="ЗАГРУЗЧИК" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="LoaderLabel" Text="Fabric" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource StatCardStyle}" Padding="16" Margin="6,0,0,0">
                                <StackPanel>
                                    <TextBlock Text="АККАУНТ" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                                    <TextBlock x:Name="AccountLabel" Text="Player" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,8,0,0" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ============ Instances ============ -->
                    <Grid x:Name="InstancesView" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,14">
                            <TextBlock Text="Установленные сборки" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Button HorizontalAlignment="Right" Content="+  Создать сборку" Style="{StaticResource PrimaryButtonStyle}" Padding="16,10" Click="NewInstanceButton_Click" />
                        </Grid>
                        <ScrollViewer Grid.Row="1">
                            <ItemsControl x:Name="InstancesList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="252" Padding="17" Margin="0,0,10,10" Loaded="InstanceCard_Loaded">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <StackPanel>
                                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Text="{Binding Subtitle}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,5,0,0" />
                                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                                    <Button Content="Играть" Style="{StaticResource CompactButtonStyle}" Tag="{Binding}" Click="PlayInstance_Click" />
                                                    <Button Content="Настроить" Style="{StaticResource CompactButtonStyle}" Tag="{Binding}" Click="EditInstance_Click" Margin="6,0,0,0" />
                                                    <Button Content="Удалить" Style="{StaticResource CompactButtonStyle}" Tag="{Binding}" Click="DeleteInstance_Click" Margin="6,0,0,0" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============ Settings ============ -->
                    <Grid x:Name="SettingsView" Visibility="Collapsed" Opacity="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Профиль" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                                        <TextBlock Text="Оффлайн ник" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsUsernameBox" MaxWidth="280" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Java и память" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                                        <TextBlock Text="Java" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsJavaPathBox" Margin="0,0,0,14" />
                                        <TextBlock Text="Выделенная память" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <ComboBox x:Name="SettingsMemoryBox" MaxWidth="200" HorizontalAlignment="Left" Margin="0,0,0,6">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <TextBlock Text="От 4 ГБ до доступной физической памяти компьютера"
                                                   FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,14" />
                                        <TextBlock Text="Дополнительные аргументы JVM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsJvmArgsBox" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Внешний вид" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                                        <TextBlock Text="Цвет акцента" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Background="#4FA8FF"
                                                    Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Background="#FF6FA8"
                                                    Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Background="#7CE0A0"
                                                    Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Background="#8B7CFF"
                                                    Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="SettingsGlassHexBox" Width="120" Margin="0,0,8,0" TextChanged="SettingsGlassHexBox_TextChanged" />
                                            <Border x:Name="SettingsGlassPreview" Width="30" Height="30" CornerRadius="15"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Дополнительно" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                                        <CheckBox x:Name="SettingsMusicEnabledBox" Content="Музыка в главном меню" Margin="0,0,0,14" />
                                        <TextBlock Text="Громкость" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <Slider x:Name="SettingsMusicVolumeSlider" Minimum="0" Maximum="1" MaxWidth="260" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                        <CheckBox x:Name="SettingsRainAutoDetectBox" Content="Автоопределение дождя" Margin="0,0,0,14" />
                                        <TextBlock Text="Ключ OpenWeatherMap" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsWeatherApiKeyBox" MaxWidth="320" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                        <TextBlock Text="Город" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsWeatherCityBox" MaxWidth="220" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Padding="20,12" Click="SaveSettings_Click" />
                                    <TextBlock x:Name="SettingsStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</Window>
