<Window x:Class="Hitboxes.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReVerfyx Client Launcher" Height="640" Width="980"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Glass tint wash over the whole window, subtle, colored by Settings -> glass color. -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource GlassTintBrush}" CornerRadius="20"
                Margin="-24" IsHitTestVisible="False" Panel.ZIndex="-1" />

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="ReVerfyx Client Launcher" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="ThemeLabel" Text="  ·  день" FontSize="16" VerticalAlignment="Bottom"
                           Margin="8,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SettingsButton" Content="Настройки" Style="{StaticResource GlassSecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="SettingsButton_Click" />
                <Button x:Name="NewInstanceButton" Content="Новая сборка" Style="{StaticResource GlassButtonStyle}"
                        Click="NewInstanceButton_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,16">
            <TextBlock Text="Ник (офлайн):" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
            <TextBox x:Name="UsernameBox" Text="Player" Width="180" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="InstancesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Width="180" Height="130" Margin="8" CornerRadius="14"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                    Loaded="InstanceCard_Loaded">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.15" BlurRadius="12" ShadowDepth="3" Direction="270" />
                                </Border.Effect>
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8" />

                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button Content="Играть" Style="{StaticResource GlassButtonStyle}" Margin="0,0,4,0"
                                                Tag="{Binding}" Click="PlayInstance_Click" />
                                        <Button Content="⚙" Style="{StaticResource GlassSecondaryButtonStyle}" Margin="0,0,4,0"
                                                Tag="{Binding}" Click="EditInstance_Click" ToolTip="Настройки сборки" />
                                        <Button Content="✕" Style="{StaticResource GlassSecondaryButtonStyle}"
                                                Tag="{Binding}" Click="DeleteInstance_Click" ToolTip="Удалить" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
</Window>
