<Window x:Class="Hitboxes.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReVerfyx Launcher" Height="700" Width="1080"
        MinHeight="620" MinWidth="900"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="58" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#B50E1017" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1" CornerRadius="18" Padding="14,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="34" Height="34" CornerRadius="10" Background="#8B7CFF" Margin="0,0,10,0">
                        <TextBlock Text="R" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontSize="17" FontWeight="Bold" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="ReVerfyx" FontSize="15" FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="ThemeLabel" Text="день" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1AFFFFFF" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="11" Padding="9,0" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="НИК" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center" Margin="0,0,7,0" />
                            <TextBox x:Name="UsernameBox" Text="Player" Width="120" Height="27"
                                     VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="SettingsButton" Content="Настройки" Style="{StaticResource GlassSecondaryButtonStyle}"
                            Margin="0,0,7,0" Click="SettingsButton_Click" />
                    <Button x:Name="NewInstanceButton" Content="+ Сборка" Style="{StaticResource GlassButtonStyle}"
                            Click="NewInstanceButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,14,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#A30E1017" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="20" Padding="15">
                <StackPanel>
                    <TextBlock Text="СБОРКИ" FontSize="9" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,2,0,10" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="InstancesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Card" Margin="0,0,0,8" Padding="12" CornerRadius="14"
                                            Background="#171A24" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                            Loaded="InstanceCard_Loaded">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                            <TextBlock Grid.Row="1" Text="{Binding Subtitle}" FontSize="9"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,9" />
                                            <StackPanel Grid.Row="2" Orientation="Horizontal">
                                                <Button Content="Играть" Style="{StaticResource GlassButtonStyle}" Padding="10,5"
                                                        Tag="{Binding}" Click="PlayInstance_Click" Margin="0,0,5,0" />
                                                <Button Content="⚙" Style="{StaticResource GlassIconButtonStyle}" Padding="8,5"
                                                        Tag="{Binding}" Click="EditInstance_Click" Margin="0,0,5,0" />
                                                <Button Content="×" Style="{StaticResource GlassIconButtonStyle}" Padding="8,5"
                                                        Tag="{Binding}" Click="DeleteInstance_Click" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Background="#B20E1017" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="24" Padding="28">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <TextBlock Text="Выбранная сборка" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Text="ReVerfyx" FontSize="36" FontWeight="SemiBold" Margin="0,5,0,0"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock x:Name="SelectedSubtitle" Text="Выберите сборку слева" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0" />
                    </StackPanel>

                    <Border Grid.Row="1" Margin="0,20,0,20" CornerRadius="20" Background="#12141C"
                            BorderBrush="#208B7CFF" BorderThickness="1">
                        <Grid>
                            <TextBlock Text="R" FontSize="170" FontWeight="Bold" HorizontalAlignment="Right"
                                       VerticalAlignment="Center" Margin="0,0,65,0" Foreground="#088B7CFF" />
                            <StackPanel VerticalAlignment="Bottom" Margin="22">
                                <TextBlock Text="ReVerfyx Client" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Fabric · Minecraft Java Edition" FontSize="9"
                                           Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                        <Button Content="▶  ИГРАТЬ" Style="{StaticResource GlassButtonStyle}" Padding="22,12"
                                Tag="{Binding ElementName=InstancesList}" Click="PlayInstance_Click" IsEnabled="False" />
                        <TextBlock Text="Выберите сборку слева для запуска" FontSize="9"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <TextBlock x:Name="StatusText" Grid.Row="2" FontSize="10" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" Margin="3,0,3,2" />
    </Grid>
</Window>
