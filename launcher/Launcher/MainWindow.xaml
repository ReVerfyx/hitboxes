<Window x:Class="Hitboxes.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReVerfyx Client Launcher" Height="640" Width="980"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Original, non-Mojang blocky landscape silhouette — sun/clouds up top,
             a grass-and-dirt strip and a couple of trees along the bottom — so
             the day/night/rain sky gradient behind it reads as a game world,
             not just an abstract color wash. Fixed art, not theme-animated. -->
        <Canvas Grid.Row="0" Grid.RowSpan="4" Margin="-24" IsHitTestVisible="False" Panel.ZIndex="-2" ClipToBounds="True">
            <!-- Pale gold reads as either a soft sun or a moon, so it doesn't
                 fight the night/rain palettes despite not being theme-animated. -->
            <Ellipse Canvas.Right="60" Canvas.Top="34" Width="60" Height="60" Fill="#FFEFE6C6" Opacity="0.8" />
            <Rectangle Canvas.Left="110" Canvas.Top="46" Width="70" Height="22" RadiusX="10" RadiusY="10" Fill="#FFFFFFFF" Opacity="0.45" />
            <Rectangle Canvas.Left="430" Canvas.Top="30" Width="90" Height="24" RadiusX="12" RadiusY="12" Fill="#FFFFFFFF" Opacity="0.35" />
            <Rectangle Canvas.Left="700" Canvas.Top="50" Width="60" Height="18" RadiusX="8" RadiusY="8" Fill="#FFFFFFFF" Opacity="0.45" />

            <!-- ground -->
            <Rectangle Canvas.Bottom="52" Canvas.Left="0" Width="1100" Height="52" Fill="#FF6FAE3E" />
            <Rectangle Canvas.Bottom="0" Canvas.Left="0" Width="1100" Height="52" Fill="#FF7A5230" />

            <!-- trees (trunk + blocky canopy), original geometric shapes -->
            <Rectangle Canvas.Bottom="52" Canvas.Left="90" Width="14" Height="34" Fill="#FF5B3B22" />
            <Rectangle Canvas.Bottom="80" Canvas.Left="66" Width="62" Height="46" Fill="#FF3C7A2E" />
            <Rectangle Canvas.Bottom="52" Canvas.Left="860" Width="14" Height="34" Fill="#FF5B3B22" />
            <Rectangle Canvas.Bottom="80" Canvas.Left="836" Width="62" Height="46" Fill="#FF3C7A2E" />
        </Canvas>

        <!-- Accent-color wash over the whole window, colored by Settings -> "Цвет стекла". -->
        <Border Grid.Row="0" Grid.RowSpan="4" Background="{DynamicResource GlassTintBrush}" CornerRadius="20"
                Margin="-24" IsHitTestVisible="False" Panel.ZIndex="-1" />

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="ReVerfyx Client" FontSize="22" FontFamily="{StaticResource PixelFontFamily}"
                           Foreground="{DynamicResource TextPrimaryBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.6" BlurRadius="0" ShadowDepth="3" Direction="315" />
                    </TextBlock.Effect>
                </TextBlock>
                <TextBlock x:Name="ThemeLabel" Text="  ·  день" FontSize="16" VerticalAlignment="Bottom"
                           Margin="10,0,0,2" Foreground="{DynamicResource TextPrimaryBrush}">
                    <TextBlock.Effect>
                        <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="4" ShadowDepth="1" Direction="315" />
                    </TextBlock.Effect>
                </TextBlock>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SettingsButton" Content="Настройки" Style="{StaticResource GlassSecondaryButtonStyle}"
                        Margin="0,0,8,0" Click="SettingsButton_Click" />
                <Button x:Name="NewInstanceButton" Content="Новая сборка" Style="{StaticResource GlassButtonStyle}"
                        Click="NewInstanceButton_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,16">
            <TextBlock Text="Ник (офлайн):" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" Opacity="0.5" BlurRadius="4" ShadowDepth="1" Direction="315" />
                </TextBlock.Effect>
            </TextBlock>
            <TextBox x:Name="UsernameBox" Text="Player" Width="180" />
        </StackPanel>

        <Border Grid.Row="2" Style="{StaticResource GlassCardStyle}" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="InstancesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Card" Width="200" Height="140" Margin="8" CornerRadius="22"
                                    Background="#B0151A22"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1.5"
                                    Loaded="InstanceCard_Loaded">
                                <Border.Effect>
                                    <DropShadowEffect Color="Black" Opacity="0.28" BlurRadius="14" ShadowDepth="4" Direction="270" />
                                </Border.Effect>
                                <Grid Margin="16">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,10" />

                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button Content="Играть" Style="{StaticResource GlassButtonStyle}" Margin="0,0,4,0"
                                                Tag="{Binding}" Click="PlayInstance_Click" />
                                        <Button Content="⚙" Style="{StaticResource GlassIconButtonStyle}" Margin="0,0,4,0"
                                                Tag="{Binding}" Click="EditInstance_Click" ToolTip="Настройки сборки" />
                                        <Button Content="✕" Style="{StaticResource GlassIconButtonStyle}"
                                                Tag="{Binding}" Click="DeleteInstance_Click" ToolTip="Удалить" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
</Window>
