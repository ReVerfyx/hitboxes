<Window x:Class="Hitboxes.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hitboxes Launcher" Height="620" Width="960"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <TextBlock Text="Hitboxes Launcher" FontSize="28" FontWeight="Bold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock x:Name="ThemeLabel" Text="  ·  день" FontSize="16" VerticalAlignment="Bottom"
                           Margin="8,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="SettingsButton" Content="Настройки" Padding="12,6" Margin="0,0,8,0"
                        Click="SettingsButton_Click" />
                <Button x:Name="NewInstanceButton" Content="Новая сборка" Padding="12,6"
                        Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0"
                        Click="NewInstanceButton_Click" />
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,8,0,16">
            <TextBlock Text="Ник (офлайн):" VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,8,0" />
            <TextBox x:Name="UsernameBox" Text="Player" Width="180" Padding="6" />
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource PanelBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="16">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="InstancesList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="180" Height="130" Margin="8" CornerRadius="10"
                                    Background="{DynamicResource BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid Margin="12">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Text="{Binding Name}" FontWeight="Bold" FontSize="15"
                                               TextWrapping="Wrap" Foreground="{DynamicResource TextPrimaryBrush}" />

                                    <TextBlock Grid.Row="1" Text="{Binding Subtitle}" FontSize="12"
                                               Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,8" />

                                    <StackPanel Grid.Row="2" Orientation="Horizontal">
                                        <Button Content="Играть" Padding="10,4" Margin="0,0,4,0"
                                                Tag="{Binding}" Click="PlayInstance_Click"
                                                Background="{DynamicResource AccentBrush}" Foreground="White" BorderThickness="0" />
                                        <Button Content="⚙" Padding="8,4" Margin="0,0,4,0"
                                                Tag="{Binding}" Click="EditInstance_Click" ToolTip="Настройки сборки" />
                                        <Button Content="✕" Padding="8,4"
                                                Tag="{Binding}" Click="DeleteInstance_Click" ToolTip="Удалить" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextSecondaryBrush}" />
    </Grid>
</Window>
