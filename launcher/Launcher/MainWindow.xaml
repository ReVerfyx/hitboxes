<Window x:Class="Hitboxes.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hitboxes Launcher" Height="560" Width="880"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,16">
            <TextBlock Text="Hitboxes Launcher" FontSize="28" FontWeight="Bold"
                       Foreground="{DynamicResource TextPrimaryBrush}" />
            <TextBlock x:Name="ThemeLabel" Text="  ·  день" FontSize="16" VerticalAlignment="Bottom"
                       Margin="8,0,0,4" Foreground="{DynamicResource TextSecondaryBrush}" />
        </StackPanel>

        <Border Grid.Row="1" Background="{DynamicResource PanelBrush}" CornerRadius="12"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="3*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,16,0">
                    <TextBlock Text="Профиль (офлайн)" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <TextBox x:Name="UsernameBox" Text="Player" Padding="8" FontSize="14" />

                    <TextBlock Text="Погода" FontWeight="SemiBold" Margin="0,20,0,6"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <CheckBox x:Name="ManualRainCheckBox" Content="Форсировать тему дождя"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              Checked="ManualRainCheckBox_Changed" Unchecked="ManualRainCheckBox_Changed" />

                    <TextBlock x:Name="StatusText" Margin="0,20,0,0" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="Версия Minecraft (Java Edition, 1.16.5+)" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                    <ComboBox x:Name="VersionComboBox" Padding="8" FontSize="14"
                              DisplayMemberPath="Id" />

                    <Button x:Name="LaunchButton" Content="Играть" Margin="0,24,0,0"
                            Padding="16,10" FontSize="16" FontWeight="Bold"
                            Background="{DynamicResource AccentBrush}" Foreground="White"
                            BorderThickness="0" Click="LaunchButton_Click" />
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Grid.Row="2" Margin="0,12,0,0" FontSize="12"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   Text="Только официальные версии с launchermeta.mojang.com. Офлайн-режим — для локальной игры и совместных миров по LAN." />
    </Grid>
</Window>
