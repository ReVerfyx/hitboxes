<Window x:Class="Hitboxes.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReVerfyx Launcher" Height="740" Width="1200"
        MinHeight="640" MinWidth="960"
        Background="{DynamicResource BackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <!-- Ambient background glow — soft blurred brand-colored blobs behind the
             sidebar/content panels, giving the frosted panels something to read as
             "glass" over without a real OS blur-behind (kept off to avoid the DWM
             calls that have crashed this app's CI runner before). -->
        <Canvas IsHitTestVisible="False">
            <Ellipse Canvas.Left="-160" Canvas.Top="-160" Width="480" Height="480" Fill="#8B7CFF" Opacity="0.16">
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
            </Ellipse>
            <Ellipse Canvas.Right="-160" Canvas.Bottom="-160" Width="480" Height="480" Fill="#6658E8" Opacity="0.14">
                <Ellipse.Effect>
                    <BlurEffect Radius="110" />
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>

        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- ============ Top toolbar (Prism Launcher's actual MainWindow.ui is a
                 QToolBar of icon+text buttons — actionAddInstance, actionFoldersButton,
                 actionSettings — plus the accounts button on the far side, not a sidebar
                 nav rail) ============ -->
            <Border Grid.Row="0" Style="{StaticResource GlassCardStyle}" CornerRadius="16" Padding="12,10">
                <Grid>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource AccentGradientBrush}" Margin="0,0,14,0">
                            <TextBlock Text="R" FontSize="15" FontWeight="Bold" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>

                        <Button Style="{StaticResource PrimaryButtonStyle}" Padding="14,9" Click="NewInstanceButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#10133;" FontSize="11" Margin="0,0,7,0" />
                                <TextBlock Text="Добавить сборку" />
                            </StackPanel>
                        </Button>

                        <Border Width="1" Height="22" Background="{DynamicResource BorderBrush}" Margin="10,0" />

                        <Button x:Name="InstancesNavButton" Style="{StaticResource NavButtonStyle}" Click="InstancesButton_Click" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#129521;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Сборки" />
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource NavButtonStyle}" Click="OpenRootFolder_Click" Margin="0,0,4,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#128193;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Папка" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="SettingsNavButton" Style="{StaticResource NavButtonStyle}" Click="SettingsButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#9881;" FontSize="12" Margin="0,0,7,0" />
                                <TextBlock Text="Настройки" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <Border x:Name="AccountChipBorder" HorizontalAlignment="Right" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="14" Padding="8,7" Cursor="Hand" MouseLeftButtonUp="AccountChip_Click"
                            ToolTip="Сменить аккаунт">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30" Height="30" CornerRadius="9" Background="{StaticResource AccentGradientBrush}">
                                <TextBlock x:Name="AvatarInitial" Text="P" FontSize="12" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,4,0" VerticalAlignment="Center">
                                <TextBlock x:Name="AccountNameText" Text="Player" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="Оффлайн аккаунт" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0" />
                            </StackPanel>
                            <TextBlock Text="&#9662;" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="8,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <Popup x:Name="AccountQuickSwitchPopup" PlacementTarget="{Binding ElementName=AccountChipBorder}"
                           Placement="Bottom" VerticalOffset="6" StaysOpen="False" AllowsTransparency="True">
                        <Border Style="{StaticResource GlassCardStyle}" Width="220" Padding="10">
                            <StackPanel>
                                <ItemsControl x:Name="QuickAccountsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding Username}" Tag="{Binding Account}" Click="QuickSelectAccount_Click"
                                                    Style="{StaticResource SecondaryButtonStyle}" HorizontalContentAlignment="Left"
                                                    HorizontalAlignment="Stretch" Margin="0,0,0,4" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Button Content="Управление аккаунтами" Style="{StaticResource PrimaryButtonStyle}"
                                        Margin="0,4,0,0" Click="OpenAccountsManagement_Click" />
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>

            <!-- ============ Main content — the instance grid is the actual home
                 view here, same as Prism's MainWindow (its central widget IS the
                 instance group view; there is no separate dashboard page) ============ -->
            <Grid Grid.Row="2">
                <!-- ============ Instances ============ -->
                    <!-- Prism-style split view: a compact icon grid on the left (click to
                         select — no per-card buttons), a fixed detail/action panel on the
                         right for whichever instance is selected. -->
                    <Grid x:Name="InstancesView" Visibility="Collapsed" Opacity="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="Сборки" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="240" />
                            </Grid.ColumnDefinitions>

                            <ScrollViewer Grid.Column="0">
                                <ItemsControl x:Name="InstancesList">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Width="128" Padding="14,16" Margin="0,0,12,12" Cursor="Hand"
                                                    Tag="{Binding}" MouseLeftButtonUp="InstanceCard_Click" Loaded="InstanceCard_Loaded">
                                                <Border.Style>
                                                    <Style TargetType="Border" BasedOn="{StaticResource StatCardStyle}">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel HorizontalAlignment="Center">
                                                    <Border Width="56" Height="56" CornerRadius="14" HorizontalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{StaticResource VanillaIconBrush}" />
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Instance.Loader}" Value="Fabric">
                                                                        <Setter Property="Background" Value="{StaticResource FabricIconBrush}" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding IconLetter}" FontSize="22" FontWeight="Bold" Foreground="White"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                               TextTrimming="CharacterEllipsis" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="108" Margin="0,10,0,0" />
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" TextAlignment="Center" MaxWidth="108" Margin="0,3,0,0" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <Border Grid.Column="2" Style="{StaticResource GlassCardStyle}" Padding="20" VerticalAlignment="Top">
                                <Grid>
                                    <StackPanel x:Name="InstanceDetailEmptyState">
                                        <TextBlock Text="Выберите сборку слева, чтобы увидеть действия." FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <StackPanel x:Name="InstanceDetailContent" Visibility="Collapsed">
                                        <Border x:Name="InstanceDetailIcon" Width="64" Height="64" CornerRadius="16" HorizontalAlignment="Left">
                                            <TextBlock x:Name="InstanceDetailIconLetter" Text="V" FontSize="26" FontWeight="Bold" Foreground="White"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <TextBlock x:Name="InstanceDetailName" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"
                                                   Margin="0,14,0,0" TextWrapping="Wrap" />
                                        <TextBlock x:Name="InstanceDetailSubtitle" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0" />

                                        <Button Content="▶  Играть" Style="{StaticResource PrimaryButtonStyle}" Margin="0,20,0,8" Click="PlaySelected_Click" />
                                        <Button Content="Настроить" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="EditSelected_Click" />
                                        <Button Content="Копировать" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="DuplicateSelected_Click" />
                                        <Button Content="Открыть папку" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,0,8" Click="OpenSelectedFolder_Click" />
                                        <Button Content="Удалить" Style="{StaticResource SecondaryButtonStyle}" Click="DeleteSelected_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- ============ Settings ============ -->
                    <Grid x:Name="SettingsView" Visibility="Collapsed" Opacity="0">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel MaxWidth="640" HorizontalAlignment="Left" Margin="0,0,0,20">

                                <TextBlock Text="Настройки" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Профиль" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                                        <TextBlock Text="Аккаунты (оффлайн-ники) — можно создать сколько угодно и переключаться между ними" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />

                                        <ItemsControl x:Name="AccountsList">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="10,8" Margin="0,0,0,6">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Username}" Foreground="{DynamicResource TextPrimaryBrush}" />
                                                                <TextBlock Text=" · текущий" Foreground="{DynamicResource AccentBrush}" FontSize="10" Margin="6,0,0,0" Visibility="{Binding CurrentBadgeVisibility}" />
                                                            </StackPanel>
                                                            <Button Grid.Column="1" Content="Выбрать" IsEnabled="{Binding CanSelect}" Tag="{Binding Account}"
                                                                    Click="SelectAccount_Click" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" />
                                                            <Button Grid.Column="2" Content="Удалить" Tag="{Binding Account}"
                                                                    Click="DeleteAccount_Click" Style="{StaticResource SecondaryButtonStyle}" />
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <TextBox x:Name="NewAccountNameBox" Width="200" Margin="0,0,8,0" />
                                            <Button Content="Добавить аккаунт" Style="{StaticResource SecondaryButtonStyle}" Click="AddAccount_Click" />
                                        </StackPanel>
                                        <TextBlock x:Name="AccountsStatusText" FontSize="11" Foreground="#D9534F" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Java и память" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                                        <TextBlock Text="Java" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsJavaPathBox" Margin="0,0,0,14" />
                                        <TextBlock Text="Выделенная память" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock x:Name="SettingsMemoryValueText" Text="4 ГБ" FontSize="14" FontWeight="Bold"
                                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8" />
                                        <Slider x:Name="SettingsMemorySlider" Minimum="4" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True"
                                                Width="320" HorizontalAlignment="Left" ValueChanged="SettingsMemorySlider_ValueChanged" />
                                        <Grid MaxWidth="320" HorizontalAlignment="Left" Margin="0,4,0,14">
                                            <TextBlock x:Name="SettingsMemoryMinLabel" Text="4 ГБ" FontSize="9"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                            <TextBlock x:Name="SettingsMemoryMaxLabel" Text="16 ГБ" FontSize="9"
                                                       Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                                        </Grid>
                                        <TextBlock Text="Дополнительные аргументы JVM" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsJvmArgsBox" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Внешний вид" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                                        <TextBlock Text="Цвет акцента" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Background="#4FA8FF"
                                                    Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Background="#FF6FA8"
                                                    Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Background="#7CE0A0"
                                                    Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                            <Border Width="30" Height="30" CornerRadius="15" Margin="0,0,8,0" Background="#8B7CFF"
                                                    Cursor="Hand" MouseLeftButtonUp="GlassSwatch_Click" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBox x:Name="SettingsGlassHexBox" Width="120" Margin="0,0,8,0" TextChanged="SettingsGlassHexBox_TextChanged" />
                                            <Border x:Name="SettingsGlassPreview" Width="30" Height="30" CornerRadius="15"
                                                    BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Дополнительно" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,14" />
                                        <CheckBox x:Name="SettingsMusicEnabledBox" Content="Музыка в главном меню" Margin="0,0,0,14" />
                                        <TextBlock Text="Громкость" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                        <Slider x:Name="SettingsMusicVolumeSlider" Minimum="0" Maximum="1" Width="260" HorizontalAlignment="Left" Margin="0,0,0,14" />
                                        <CheckBox x:Name="SettingsRainAutoDetectBox" Content="Автоопределение дождя" Margin="0,0,0,14" />
                                        <TextBlock Text="Ключ OpenWeatherMap" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsWeatherApiKeyBox" MaxWidth="320" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                        <TextBlock Text="Город" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsWeatherCityBox" MaxWidth="220" HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Сеть" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="Если Mojang недоступен напрямую (таймаут до launchermeta.mojang.com и т.п.) — включи прокси или зеркало."
                                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,14" />

                                        <CheckBox x:Name="SettingsProxyEnabledBox" Content="Использовать прокси" Margin="0,0,0,10" />
                                        <TextBlock Text="Адрес (host:port, или http://.../socks5://...)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsProxyAddressBox" MaxWidth="320" HorizontalAlignment="Left" Margin="0,0,0,10" />
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock Text="Логин (необязательно)" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                <TextBox x:Name="SettingsProxyUsernameBox" Width="150" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock Text="Пароль" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,6" />
                                                <PasswordBox x:Name="SettingsProxyPasswordBox" Width="150" />
                                            </StackPanel>
                                        </StackPanel>

                                        <CheckBox x:Name="SettingsMirrorFallbackBox" Content="Автоматически пробовать зеркало Mojang, если прямое подключение не отвечает"
                                                  TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <TextBlock Text="Зеркало (host=зеркало через запятую, напр. launchermeta.mojang.com=example.com) — впиши сюда рабочий адрес, автоматически ничего не подставляется"
                                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,6" />
                                        <TextBox x:Name="SettingsMirrorOverridesBox" TextWrapping="Wrap" AcceptsReturn="False" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource StatCardStyle}" Padding="18" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="Разработчик" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,6" />
                                        <TextBlock Text="Полный журнал (статус-бар + необработанные ошибки с трассировкой) — скопируй сюда, если что-то не работает."
                                                   FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10" />
                                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1" CornerRadius="10">
                                            <TextBox x:Name="DevConsoleBox" IsReadOnly="True" TextWrapping="Wrap"
                                                     FontFamily="Consolas" FontSize="10" Height="160"
                                                     VerticalScrollBarVisibility="Auto" BorderThickness="0" Background="Transparent" />
                                        </Border>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Content="Копировать" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="CopyDevConsole_Click" />
                                            <Button Content="Обновить" Style="{StaticResource SecondaryButtonStyle}" Margin="0,0,8,0" Click="RefreshDevConsole_Click" />
                                            <Button Content="Открыть папку логов" Style="{StaticResource SecondaryButtonStyle}" Click="OpenLogsFolder_Click" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Сохранить" Style="{StaticResource PrimaryButtonStyle}" Padding="20,12" Click="SaveSettings_Click" />
                                    <TextBlock x:Name="SettingsStatusText" VerticalAlignment="Center" Margin="12,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>
                </Grid>

            <!-- ============ Status bar (Prism's MainWindow has a real QStatusBar
                 docked at the window bottom) ============ -->
            <Border Grid.Row="4" Style="{StaticResource StatCardStyle}" Padding="14,10">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="7" Height="7" Fill="#4ADE80" VerticalAlignment="Center">
                        <Ellipse.Effect>
                            <DropShadowEffect Color="#4ADE80" Opacity="0.8" BlurRadius="8" ShadowDepth="0" />
                        </Ellipse.Effect>
                    </Ellipse>
                    <TextBlock x:Name="StatusText" Text="Готов к запуску" FontSize="11" Margin="7,0,0,0"
                               Foreground="{DynamicResource TextPrimaryBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
