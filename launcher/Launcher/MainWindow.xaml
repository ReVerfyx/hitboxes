<Window x:Class="Hitboxes.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReVerfyx Launcher" Height="720" Width="1160"
        MinHeight="620" MinWidth="900"
        Background="{DynamicResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="16">
        <Grid.ColumnDefinitions><ColumnDefinition Width="220"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#C90D0F16" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="22" Padding="14">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <StackPanel Orientation="Horizontal" Margin="4,3,4,25">
                        <Border Width="38" Height="38" CornerRadius="12" Background="#8B7CFF"><TextBlock Text="R" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="ReVerfyx" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="Launcher" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,2,0,0"/></StackPanel>
                    </StackPanel>
                    <TextBlock Text="БИБЛИОТЕКА" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}" Margin="4,0,0,7"/>
                    <Button Content="Главная" Style="{StaticResource GlassSecondaryButtonStyle}" Margin="0,0,0,4" Click="HomeButton_Click"/>
                    <Button Content="Сборки" Style="{StaticResource GlassSecondaryButtonStyle}" Margin="0,0,0,4" Click="InstancesButton_Click"/>
                    <Button Content="Настройки" Style="{StaticResource GlassSecondaryButtonStyle}" Click="SettingsButton_Click"/>
                </StackPanel>
                <Border DockPanel.Dock="Bottom" Background="#151720" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="14" Padding="12">
                    <StackPanel><TextBlock Text="ОФФЛАЙН АККАУНТ" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBox x:Name="UsernameBox" Text="Player" Margin="0,7,0,0" Height="27" VerticalContentAlignment="Center" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" TextChanged="UsernameBox_TextChanged"/></StackPanel>
                </Border>
            </DockPanel>
        </Border>
        <Grid Grid.Column="2">
            <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0"><StackPanel VerticalAlignment="Center"><TextBlock x:Name="PageTitle" Text="Главная" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock x:Name="PageSubtitle" Text="Выбранная сборка" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,3,0,0"/></StackPanel><Button HorizontalAlignment="Right" Content="+  СОЗДАТЬ СБОРКУ" Style="{StaticResource GlassButtonStyle}" Padding="15,9" Click="NewInstanceButton_Click"/></Grid>
            <Grid Grid.Row="1">
                <Grid x:Name="HomeView">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Grid.Row="0" Background="#B20E1017" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="25" Padding="30">
                        <Grid><StackPanel VerticalAlignment="Bottom"><TextBlock Text="ВЫБРАННАЯ СБОРКА" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="SelectedName" Text="ReVerfyx" FontSize="40" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,6,0,0"/><TextBlock x:Name="SelectedSubtitle" Text="Minecraft 1.21.4 · Fabric" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/><StackPanel Orientation="Horizontal" Margin="0,22,0,0"><Button Content="▶  ИГРАТЬ" Style="{StaticResource GlassButtonStyle}" Padding="24,12" Click="PlaySelected_Click"/><Button Content="Настроить" Style="{StaticResource GlassSecondaryButtonStyle}" Padding="18,11" Margin="8,0,0,0" Click="EditSelected_Click"/></StackPanel></StackPanel><TextBlock Text="R" FontSize="220" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#068B7CFF" Margin="0,0,55,20"/></Grid>
                    </Border>
                    <Grid Grid.Row="1" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Background="#A80E1017" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="14" Margin="0,0,5,0"><StackPanel><TextBlock Text="ПАМЯТЬ" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="RamLabel" Text="4 ГБ" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="1" Background="#A80E1017" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="14" Margin="5,0"><StackPanel><TextBlock Text="ЗАГРУЗЧИК" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock Text="Fabric" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border><Border Grid.Column="2" Background="#A80E1017" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="15" Padding="14" Margin="5,0,0,0"><StackPanel><TextBlock Text="АККАУНТ" FontSize="8" Foreground="{DynamicResource TextSecondaryBrush}"/><TextBlock x:Name="AccountLabel" Text="Player" FontSize="14" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border></Grid>
                </Grid>
                <Grid x:Name="InstancesView" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Grid.Row="0" Text="Установленные сборки" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,12"/><ScrollViewer Grid.Row="1"><ItemsControl x:Name="InstancesList"><ItemsControl.ItemTemplate><DataTemplate><Border Background="#A80E1017" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="17" Padding="15" Margin="0,0,0,8"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/><TextBlock Text="{Binding Subtitle}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Играть" Style="{StaticResource GlassButtonStyle}" Tag="{Binding}" Click="PlayInstance_Click" Padding="12,7"/><Button Content="Настроить" Style="{StaticResource GlassSecondaryButtonStyle}" Tag="{Binding}" Click="EditInstance_Click" Padding="11,7" Margin="6,0,0,0"/><Button Content="Удалить" Style="{StaticResource GlassSecondaryButtonStyle}" Tag="{Binding}" Click="DeleteInstance_Click" Padding="11,7" Margin="6,0,0,0"/></StackPanel></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Grid>
                <ScrollViewer x:Name="SettingsView" Visibility="Collapsed"><StackPanel MaxWidth="760"><Border Background="#A80E1017" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Margin="0,0,0,10"><StackPanel><TextBlock Text="АККАУНТ" FontSize="10" FontWeight="SemiBold" Padding="16" Foreground="{DynamicResource TextPrimaryBrush}"/><Border Height="1" Background="{DynamicResource BorderBrush}"/><Grid Margin="16,12"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Оффлайн ник" FontSize="11"/><TextBlock Text="Имя игрока без авторизации Microsoft" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Column="1" x:Name="SettingsUsernameBox" Text="Player" Height="30" VerticalContentAlignment="Center" TextChanged="SettingsUsernameBox_TextChanged"/></Grid></StackPanel></Border>
                    <Border Background="#A80E1017" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18" Margin="0,0,0,10"><StackPanel><TextBlock Text="JAVA И ПАМЯТЬ" FontSize="10" FontWeight="SemiBold" Padding="16"/><Border Height="1" Background="{DynamicResource BorderBrush}"/><Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Выделенная память" FontSize="11"/><TextBlock Text="От 4 ГБ до доступной памяти компьютера" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><ComboBox Grid.Column="1" x:Name="RamCombo" SelectedIndex="0" SelectionChanged="RamCombo_SelectionChanged" Height="30"/><StackPanel Grid.Row="1" Margin="0,12,0,0"><TextBlock Text="Java" FontSize="11"/><TextBlock Text="Исполняемый файл Java" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Row="1" Grid.Column="1" x:Name="JavaBox" Text="javaw.exe" Height="30" VerticalContentAlignment="Center"/><StackPanel Grid.Row="2" Margin="0,12,0,0"><TextBlock Text="Аргументы JVM" FontSize="11"/><TextBlock Text="Дополнительные параметры запуска" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,4,0,0"/></StackPanel><TextBox Grid.Row="2" Grid.Column="1" x:Name="JvmBox" Height="30" VerticalContentAlignment="Center"/></Grid></StackPanel></Border>
                    <Border Background="#A80E1017" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="18"><StackPanel><TextBlock Text="ИГРА" FontSize="10" FontWeight="SemiBold" Padding="16"/><Border Height="1" Background="{DynamicResource BorderBrush}"/><Grid Margin="16,12"><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="Полноэкранный режим" FontSize="11"/><CheckBox Grid.Column="1" x:Name="FullscreenBox" HorizontalAlignment="Left" VerticalAlignment="Center"/><TextBlock Grid.Row="1" Text="Разрешение" FontSize="11" Margin="0,12,0,0"/><ComboBox Grid.Row="1" Grid.Column="1" x:Name="ResolutionCombo" Height="30" Margin="0,12,0,0"><ComboBoxItem Content="1280 × 720"/><ComboBoxItem Content="1920 × 1080" IsSelected="True"/><ComboBoxItem Content="2560 × 1440"/></ComboBox><TextBlock Grid.Row="2" Text="Папка игры" FontSize="11" Margin="0,12,0,0"/><TextBox Grid.Row="2" Grid.Column="1" Text=".minecraft" Height="30" Margin="0,12,0,0"/></Grid></StackPanel></Border>
                </StackPanel></ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>